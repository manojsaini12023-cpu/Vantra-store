{
  "name": "clothing-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"bgBlue.bold,bgMagenta.bold\" \"npm run server\" \"npm run client\"",
    "client": "npm run dev --prefix client",
    "client:build": "npm run build --prefix client",
    "server": "npm run dev --prefix server",
    "server:start": "npm start --prefix server",
    "start": "node server/server.js",
    "build": "npm run build --prefix client",
    "test:api": "npm test --prefix server",
    "lint": "npm run lint --prefix client",
    "install:all": "npm install --prefix client && npm install --prefix server"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
