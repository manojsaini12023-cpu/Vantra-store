# ==============================================================================
# VANTA STREETWEAR // ENVIRONMENT TEMPLATE (.env.example)
# Duplicate this file as .env and fill in your actual credentials.
# ==============================================================================

# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
API_BASE_URL=http://localhost:5000

# Cloud MongoDB Atlas
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGODB_DB_NAME=vanta_streetwear
MONGODB_USER=
MONGODB_PASSWORD=
MONGODB_CLUSTER=

# Razorpay Payments (UPI / Cards / Netbanking)
RAZORPAY_KEY_ID=rzp_test_YourKeyIdHere
RAZORPAY_KEY_SECRET=YourRazorpaySecretKeyHere
RAZORPAY_WEBHOOK_SECRET=YourRazorpayWebhookSecretHere
RAZORPAY_CURRENCY=INR

# UPI Direct
UPI_MERCHANT_VPA=vanta.streetwear@okhdfcbank
UPI_MERCHANT_NAME=VANTA STUDIO PVT LTD
UPI_MERCHANT_CODE=5691

# Stripe Payments (Global Cards / Apple Pay)
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_CURRENCY=inr

# Cashfree Payments
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_API_VERSION=2023-08-01
CASHFREE_ENV=TEST

# Cloudinary (Media & Image Uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_URL=

# Security & Secrets
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d
ADMIN_SECRET_KEY=your_admin_secret_key_here

# Currency Exchange API
EXCHANGE_RATE_API_KEY=

# Shipping API (Shiprocket)
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
